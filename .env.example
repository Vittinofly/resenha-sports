# Copie para .env.local e preencha.

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# --- Site (recomendado: usado em SEO, sitemap e links de divulgação) ---
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# --- Contato (opcional: cada item só aparece no site se estiver preenchido) ---
# WhatsApp com DDD, só números. Ativa o botão flutuante e o "Agilizar pelo WhatsApp".
NEXT_PUBLIC_WHATSAPP_CONTATO=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_ENDERECO=
NEXT_PUBLIC_CIDADE=
NEXT_PUBLIC_MAPS_URL=
