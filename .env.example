# Copie para .env.local e preencha.

# --- Plataforma multi-tenant ---
# Domínio raiz da plataforma, sem https (ex.: reservas.com.br). Nele fica o painel do
# super-usuário e cada empresa ganha um subdomínio. Vazio: todo domínio abre a empresa padrão.
NEXT_PUBLIC_ROOT_DOMAIN=
# Slug da empresa aberta em localhost, nos previews da Vercel e quando não há domínio raiz
NEXT_PUBLIC_EMPRESA_PADRAO=resenha
# Só no servidor, NUNCA com prefixo NEXT_PUBLIC_. Necessária para convidar a equipe das empresas.
# Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# --- Site (recomendado: usado em SEO, sitemap e links de divulgação) ---
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Os itens abaixo valem só para a empresa padrão, quando o campo estiver vazio no painel.
# As demais empresas configuram tudo em /admin/configuracoes ou no painel da plataforma.

# --- Contato (opcional: cada item só aparece no site se estiver preenchido) ---
# WhatsApp com DDD, só números. Ativa o botão flutuante e o "Agilizar pelo WhatsApp".
NEXT_PUBLIC_WHATSAPP_CONTATO=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_ENDERECO=
NEXT_PUBLIC_CIDADE=
NEXT_PUBLIC_MAPS_URL=

# --- Sinal via Pix (opcional: sem chave, nenhuma reserva cobra sinal) ---
# Chave Pix (CNPJ, e-mail, telefone +55... ou aleatória). Valores e regras: tela de configurações.
NEXT_PUBLIC_PIX_CHAVE=
# Nome do titular (até 25 caracteres) e cidade (até 15), como cadastrados no banco
NEXT_PUBLIC_PIX_TITULAR=
NEXT_PUBLIC_PIX_CIDADE=

# --- Google (opcional) ---
# Google Analytics 4 (G-XXXXXXX). Só carrega após o visitante aceitar o aviso de cookies.
NEXT_PUBLIC_GA_ID=
# Search Console > Tag HTML: cole só o valor do atributo content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
